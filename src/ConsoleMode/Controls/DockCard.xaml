<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConsoleMode.Controls.DockCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ConsoleMode.ViewModels">

    <!-- One card of the dock: small and quiet until the focus or the pointer reaches it, then it grows (and pushes its
         neighbours aside) to show what it opens, where, what changes, and Play. Liquid glass tinted with the card's own colour. -->
    <Grid x:Name="Card" Width="168" Height="168" VerticalAlignment="Bottom">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SizeStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.55">
                        <VisualTransition.GeneratedEasingFunction>
                            <QuinticEase EasingMode="EaseInOut"/>
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Compact"/>
                <VisualState x:Name="Expanded">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Width" To="560" Duration="0:0:0.55" EnableDependentAnimation="True">
                            <DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Height" To="320" Duration="0:0:0.55" EnableDependentAnimation="True">
                            <DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Details" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.2" Duration="0:0:0.4"/>
                        <DoubleAnimation Storyboard.TargetName="IconBox" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.2" Duration="0:0:0.4"/>
                        <DoubleAnimation Storyboard.TargetName="Caption" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.1" Duration="0:0:0.45"/>
                        <DoubleAnimation Storyboard.TargetName="CompactLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="EdgeFocus" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4"/>
                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"/>
                        <DoubleAnimation Storyboard.TargetName="ShineShift" Storyboard.TargetProperty="X" From="-1.4" To="1.4" Duration="0:0:1.2" EnableDependentAnimation="True">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="1"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:0.95" Value="1"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Button x:Name="Body" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                Padding="0" UseSystemFocusVisuals="False" Foreground="White"
                AutomationProperties.Name="{x:Bind Tile.Text, Mode=OneWay}"
                Click="OnBodyClick" RightTapped="OnBodyRightTapped"
                GotFocus="OnBodyGotFocus" LostFocus="OnBodyLostFocus"
                PointerEntered="OnBodyPointerEntered" PointerExited="OnBodyPointerExited">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter Content="{TemplateBinding Content}" AutomationProperties.AccessibilityView="Raw"/>
                </ControlTemplate>
            </Button.Template>
            <Grid>
                <Border Background="{StaticResource GlassFill}" CornerRadius="36"/>
                <Border Background="{x:Bind Tile.TintBrush, Mode=OneWay}" CornerRadius="36"/>
                <!-- The card's own picture (a brush, so it follows the rounded corners) -->
                <Border CornerRadius="36" Visibility="{x:Bind Tile.HasCardImage, Mode=OneWay}">
                    <Border.Background>
                        <ImageBrush ImageSource="{x:Bind Tile.CardImage, Mode=OneWay}" Stretch="Uniform" AlignmentX="Center" AlignmentY="Center"/>
                    </Border.Background>
                </Border>
                <!-- Under the text of an open card: the background behind it blurs and darkens, so the words read over any picture -->
                <Border x:Name="Caption" Opacity="0" VerticalAlignment="Bottom" Height="190" CornerRadius="0,0,36,36" Background="{StaticResource GlassDeep}"/>
                <Border Background="{StaticResource GlassSheen}" CornerRadius="36" IsHitTestVisible="False"/>
                <Border x:Name="Shine" Opacity="0" CornerRadius="36" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                            <LinearGradientBrush.RelativeTransform>
                                <TranslateTransform x:Name="ShineShift" X="-1.4"/>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#00FFFFFF" Offset="0.3"/>
                            <GradientStop Color="#40FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.7"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border BorderBrush="{StaticResource GlassEdge}" BorderThickness="1.2" CornerRadius="36" IsHitTestVisible="False"/>
                <Border x:Name="EdgeFocus" Opacity="0" BorderBrush="{StaticResource GlassEdgeFocused}" BorderThickness="2.5" CornerRadius="36" IsHitTestVisible="False"/>
                <Border x:Name="Glow" Opacity="0" Margin="-7" BorderBrush="#2EFFFFFF" BorderThickness="6" CornerRadius="42" IsHitTestVisible="False"/>

                <!-- The name while the card is small; the icon only once it is open, and smaller -->
                <Grid Margin="28">
                    <Grid x:Name="IconBox" Opacity="0" Width="52" Height="52" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Image Source="{x:Bind Tile.Logo, Mode=OneWay}" Stretch="Uniform" Visibility="{x:Bind Tile.HasLogo, Mode=OneWay}"/>
                        <FontIcon Glyph="{x:Bind Tile.Glyph}" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="{x:Bind Tile.ShowGlyph, Mode=OneWay}"/>
                    </Grid>
                    <TextBlock x:Name="CompactLabel" Text="{x:Bind Tile.Text, Mode=OneWay}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Bottom"
                               TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="#F2FFFFFF"/>
                </Grid>

                <!-- Only while the card is open: what it is, where and what changes, and the way to play -->
                <StackPanel x:Name="Details" Opacity="0" IsHitTestVisible="False" Margin="30,0,30,28" VerticalAlignment="Bottom" Spacing="6">
                    <TextBlock Text="{x:Bind Tile.Text, Mode=OneWay}" FontSize="38" FontWeight="Bold" CharacterSpacing="-20" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    <TextBlock Text="{x:Bind Tile.Info, Mode=OneWay}" FontSize="18" Foreground="#E6FFFFFF" TextWrapping="Wrap" MaxLines="3"
                               Visibility="{x:Bind Tile.HasInfo, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind Host.HomeMetaLine, Mode=OneWay}" FontSize="17" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1"
                               Visibility="{x:Bind Tile.IsLauncher, Mode=OneWay}"/>
                    <Border Margin="0,10,0,0" HorizontalAlignment="Left" CornerRadius="26" Padding="28,12" Background="{x:Bind Tile.AccentBrush, Mode=OneWay}"
                            BorderBrush="{StaticResource GlassEdgeFocused}" BorderThickness="1.2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="{x:Bind Tile.ActionGlyph}" FontSize="20" Foreground="White"/>
                            <TextBlock Text="{x:Bind Tile.ActionText, Mode=OneWay}" FontSize="21" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Button>
    </Grid>
</UserControl>
