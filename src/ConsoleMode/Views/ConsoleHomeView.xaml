<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ConsoleMode.Views.ConsoleHomeView"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ConsoleMode.ViewModels"
    xmlns:controls="using:ConsoleMode.Controls"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    XYFocusKeyboardNavigation="Enabled"
    RequestedTheme="Dark"
    FontFamily="{StaticResource ConsoleFontFamily}">
    <UserControl.Resources>
        <!-- Buttons and other controls take their font from this key, not from the parent. -->
        <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="ConsoleFontFamily"/>
        <!-- Lights and dims the System categories smoothly instead of switching them at once. -->
        <ScalarTransition x:Key="ConsoleFade" Duration="0:0:0.18"/>
    </UserControl.Resources>

    <!-- 10-foot layout: big cards, thick focus ring, no mouse needed. Solid background instead of Mica. The view also
         fills the title bar (the top padding leaves its 48 px free), so the background runs up to the window edge. -->
    <Grid x:Name="Root" Background="#07090D" Padding="56,48,56,32">
        <Grid.Resources>
            <!-- Containers of cards are not focus stops: the focus lands on the cards themselves. -->
            <Style TargetType="ItemsControl">
                <Setter Property="IsTabStop" Value="False"/>
            </Style>
            <Style x:Key="ConsoleHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Margin" Value="4,0,0,12"/>
            </Style>
        </Grid.Resources>

        <!-- Background: the built-in wallpaper, covers of your installed Steam games or your picture, under a solid-colour gradient -->
        <Grid x:Name="BackgroundLayer" IsHitTestVisible="False" Margin="-56,-48,-56,-32">
            <!-- Built-in wallpaper ("Aurora"): soft green and blue glows over a deep blue-black with a few faint
                 orbit lines, all on the right, where the gradients below leave the art visible -->
            <Grid Visibility="{x:Bind ViewModel.ShowBackgroundWallpaper, Mode=OneWay}">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                            <GradientStop Color="#FF0C1828" Offset="0"/>
                            <GradientStop Color="#FF080E17" Offset="0.5"/>
                            <GradientStop Color="#FF07090D" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.82,0.12" GradientOrigin="0.82,0.12" RadiusX="0.5" RadiusY="0.85">
                            <GradientStop Color="#A62FB88C" Offset="0"/>
                            <GradientStop Color="#3D1E9C74" Offset="0.45"/>
                            <GradientStop Color="#001E9C74" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="1.04,0.78" GradientOrigin="1.04,0.78" RadiusX="0.42" RadiusY="0.7">
                            <GradientStop Color="#A62F6FE0" Offset="0"/>
                            <GradientStop Color="#382F6FE0" Offset="0.5"/>
                            <GradientStop Color="#002F6FE0" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.66,-0.06" GradientOrigin="0.66,-0.06" RadiusX="0.32" RadiusY="0.55">
                            <GradientStop Color="#666A4FE0" Offset="0"/>
                            <GradientStop Color="#006A4FE0" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Ellipse Width="1300" Height="1300" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-440,-460,0" StrokeThickness="1.5">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                            <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                            <GradientStop Color="#59FFFFFF" Offset="0.85"/>
                            <GradientStop Color="#14FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                </Ellipse>
                <Ellipse Width="1800" Height="1800" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-660,-700,0" StrokeThickness="1">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                            <GradientStop Color="#009BEACF" Offset="0.55"/>
                            <GradientStop Color="#479BEACF" Offset="0.85"/>
                            <GradientStop Color="#109BEACF" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                </Ellipse>
                <Ellipse Width="2400" Height="2400" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-940,-1000,0" StrokeThickness="1">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                            <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                            <GradientStop Color="#2EFFFFFF" Offset="0.85"/>
                            <GradientStop Color="#0AFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                </Ellipse>
            </Grid>
            <Grid Visibility="{x:Bind ViewModel.ShowBackgroundCovers, Mode=OneWay}" Opacity="0.55">
                <ItemsControl ItemsSource="{x:Bind ViewModel.BackgroundCovers, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="240" ItemHeight="360"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="media:ImageSource">
                            <Image Source="{x:Bind}" Stretch="UniformToFill" Width="228" Height="342" Margin="6"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <Image Source="{x:Bind ViewModel.BackgroundCustomImage, Mode=OneWay}" Stretch="UniformToFill" Opacity="0.7"
                   Visibility="{x:Bind ViewModel.ShowBackgroundCustom, Mode=OneWay}"/>
            <!-- The background of the card in focus, over the usual one (fades in and out) -->
            <Image Source="{x:Bind ViewModel.AmbientBackground, Mode=OneWay}" Stretch="UniformToFill" IsHitTestVisible="False"
                   Opacity="{x:Bind ViewModel.ShownOpacity(ViewModel.HasAmbientBackground), Mode=OneWay}" OpacityTransition="{StaticResource ConsoleFade}"/>
            <!-- The selected launcher tints the background like the cover of a game on a console home -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.72,0.32" GradientOrigin="0.72,0.32" RadiusX="0.75" RadiusY="0.9">
                        <GradientStop Color="{x:Bind ViewModel.AmbientColor, Mode=OneWay}" Offset="0"/>
                        <GradientStop Color="{x:Bind ViewModel.AmbientFade, Mode=OneWay}" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Like a console home: the art shows on the right and fades to black on the left (where the text is)
                 and at the bottom, so the text stays readable over any picture -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F507090D" Offset="0"/>
                        <GradientStop Color="#C707090D" Offset="0.4"/>
                        <GradientStop Color="#4D07090D" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#F207090D" Offset="0"/>
                        <GradientStop Color="#0007090D" Offset="0.55"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- While a card of the dock is open the background blurs and dims behind it -->
            <Border Background="{StaticResource GlassDeep}" IsHitTestVisible="False"
                    Opacity="{x:Bind ViewModel.ShownOpacity(ViewModel.IsDockOpen), Mode=OneWay}" OpacityTransition="{StaticResource ConsoleFade}"/>
            <!-- System tab: the art dims much more, so the rows of options stay readable over any cover or picture -->
            <Rectangle Fill="#D207090D" Opacity="{x:Bind ViewModel.ShownOpacity(ViewModel.IsConsoleSettingsOpen), Mode=OneWay}"
                       OpacityTransition="{StaticResource ConsoleFade}"/>
        </Grid>

        <!-- ───────────── Idle (console-style: tabs on top, one page below) ───────────── -->
        <Grid Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}" RowSpacing="14" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Clock and controller battery: all that is left of the top bar -->
            <Border Grid.Row="0" Style="{StaticResource GlassCapsule}" Padding="26,8" CornerRadius="28" Height="56" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7FC;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.HasControllerBattery, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.ControllerBatteryLabel, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.ControllerBatteryGlyph, Mode=OneWay}" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.ControllerBatteryText, Mode=OneWay}" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="ClockText" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                </Border>

            <!-- Status banner -->
            <Border Grid.Row="1" Visibility="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}" CornerRadius="12" Padding="20,14"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="18" TextWrapping="Wrap"/>
            </Border>

            <!-- Update notice: HomeView's InfoBar isn't on this screen, so the console interface
                 needs its own way to actually install an update, not just find one (issue #49). -->
            <Border Grid.Row="1" Visibility="{x:Bind ViewModel.IsUpdateOpen, Mode=OneWay}" Style="{StaticResource GlassCapsule}" CornerRadius="26" Padding="28,20" Margin="0,0,0,4">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.UpdateTitle, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}" FontSize="15" TextWrapping="Wrap" MaxWidth="720"
                                   Foreground="#D9FFFFFF"/>
                    </StackPanel>
                    <!-- A white focus ring, like the rest of the glass. -->
                    <Button x:Name="UpdateNowButton" Grid.Column="1" Style="{StaticResource ConsoleSmallButton}" Height="48" Padding="20,0" FocusVisualPrimaryBrush="White"
                            Command="{x:Bind ViewModel.ApplyUpdateCommand}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsUpdating, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsUpdating, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind ViewModel.UpdateActionText, Mode=OneWay}"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource ConsoleSmallButton}" Height="48" Padding="20,0" FocusVisualPrimaryBrush="White"
                            Command="{x:Bind ViewModel.SkipUpdateCommand}" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.Texts.IgnoreUpdate, Mode=OneWay}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Pages: one per tab -->
            <Grid Grid.Row="2">
                <!-- Home: the dock. Cards sit low and small; the one with the focus or the pointer opens up (Play, where, what changes). -->
                <Grid x:Name="HomePanel" Visibility="{x:Bind ViewModel.IsHomeTab, Mode=OneWay}">
                    <ScrollViewer x:Name="DockScroll" VerticalAlignment="Bottom" Height="372" Margin="0,0,0,8"
                                  HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="LaunchRow" ItemsSource="{x:Bind ViewModel.LaunchTiles, Mode=OneWay}" VerticalAlignment="Bottom" Margin="8,0,8,0" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="22" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LaunchTile">
                                    <controls:DockCard Tile="{x:Bind}" Host="{Binding ViewModel, ElementName=Page}"
                                                       Invoked="OnLaunchTileInvoked" MenuRequested="OnLaunchTileMenuRequested" Opened="OnLaunchTileOpened" Closed="OnLaunchTileClosed"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- System tab: every setting, as rows -->
                <Grid x:Name="SettingsPanel" Visibility="{x:Bind ViewModel.IsConsoleSettingsOpen, Mode=OneWay}">
                    <Grid.Resources>
                        <!-- Row content: label + value -->
                        <Style x:Key="RowLabel" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="MaxLines" Value="2"/>
                        </Style>
                        <Style x:Key="RowValue" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="MaxLines" Value="2"/>
                            <Setter Property="MaxWidth" Value="420"/>
                        </Style>
                    </Grid.Resources>
                    <!-- Categories on the left (moving over one shows its options), only that category's options on the right -->
                    <Grid ColumnSpacing="40">
                        <Grid.ColumnDefinitions>
                            <!-- Wide enough for the longest names (German, French: ~34 characters); longer ones wrap to a second line (issue #219) -->
                            <ColumnDefinition Width="400"/>
                            <!-- Capped here, not on the list: the options stay right next to the categories on a wide TV -->
                            <ColumnDefinition Width="*" MaxWidth="1100"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="CategoryRail" Spacing="4" Padding="14,4,0,0">
                            <Button Style="{StaticResource ConsoleCategory}" Tag="0" Click="OnCategoryClick" GotFocus="OnCategoryFocused">
                                <Grid>
                                    <Border Width="4" Height="28" CornerRadius="2" HorizontalAlignment="Left" Margin="-14,0,0,0" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Opacity="{x:Bind ViewModel.IndicatorOpacity(ViewModel.SystemCategory, 0), Mode=OneWay}"
                                            OpacityTransition="{StaticResource ConsoleFade}"/>
                                    <TextBlock Text="{x:Bind ViewModel.Texts.EnteringConsoleSection, Mode=OneWay}" FontSize="20" TextWrapping="Wrap" MaxLines="2" LineHeight="24" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Opacity="{x:Bind ViewModel.TabOpacity(ViewModel.SystemCategory, 0), Mode=OneWay}"
                                               OpacityTransition="{StaticResource ConsoleFade}"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource ConsoleCategory}" Tag="1" Click="OnCategoryClick" GotFocus="OnCategoryFocused">
                                <Grid>
                                    <Border Width="4" Height="28" CornerRadius="2" HorizontalAlignment="Left" Margin="-14,0,0,0" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Opacity="{x:Bind ViewModel.IndicatorOpacity(ViewModel.SystemCategory, 1), Mode=OneWay}"
                                            OpacityTransition="{StaticResource ConsoleFade}"/>
                                    <TextBlock Text="{x:Bind ViewModel.Texts.ControllerSection, Mode=OneWay}" FontSize="20" TextWrapping="Wrap" MaxLines="2" LineHeight="24" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Opacity="{x:Bind ViewModel.TabOpacity(ViewModel.SystemCategory, 1), Mode=OneWay}"
                                               OpacityTransition="{StaticResource ConsoleFade}"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource ConsoleCategory}" Tag="2" Click="OnCategoryClick" GotFocus="OnCategoryFocused">
                                <Grid>
                                    <Border Width="4" Height="28" CornerRadius="2" HorizontalAlignment="Left" Margin="-14,0,0,0" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Opacity="{x:Bind ViewModel.IndicatorOpacity(ViewModel.SystemCategory, 2), Mode=OneWay}"
                                            OpacityTransition="{StaticResource ConsoleFade}"/>
                                    <TextBlock Text="{x:Bind ViewModel.Texts.OptionalExtrasSection, Mode=OneWay}" FontSize="20" TextWrapping="Wrap" MaxLines="2" LineHeight="24" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Opacity="{x:Bind ViewModel.TabOpacity(ViewModel.SystemCategory, 2), Mode=OneWay}"
                                               OpacityTransition="{StaticResource ConsoleFade}"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource ConsoleCategory}" Tag="3" Click="OnCategoryClick" GotFocus="OnCategoryFocused">
                                <Grid>
                                    <Border Width="4" Height="28" CornerRadius="2" HorizontalAlignment="Left" Margin="-14,0,0,0" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Opacity="{x:Bind ViewModel.IndicatorOpacity(ViewModel.SystemCategory, 3), Mode=OneWay}"
                                            OpacityTransition="{StaticResource ConsoleFade}"/>
                                    <TextBlock Text="{x:Bind ViewModel.Texts.AppSection, Mode=OneWay}" FontSize="20" TextWrapping="Wrap" MaxLines="2" LineHeight="24" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Opacity="{x:Bind ViewModel.TabOpacity(ViewModel.SystemCategory, 3), Mode=OneWay}"
                                               OpacityTransition="{StaticResource ConsoleFade}"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource ConsoleCategory}" Tag="4" Click="OnCategoryClick" GotFocus="OnCategoryFocused">
                                <Grid>
                                    <Border Width="4" Height="28" CornerRadius="2" HorizontalAlignment="Left" Margin="-14,0,0,0" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Opacity="{x:Bind ViewModel.IndicatorOpacity(ViewModel.SystemCategory, 4), Mode=OneWay}"
                                            OpacityTransition="{StaticResource ConsoleFade}"/>
                                    <TextBlock Text="{x:Bind ViewModel.Texts.HelpDataSection, Mode=OneWay}" FontSize="20" TextWrapping="Wrap" MaxLines="2" LineHeight="24" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Opacity="{x:Bind ViewModel.TabOpacity(ViewModel.SystemCategory, 4), Mode=OneWay}"
                                               OpacityTransition="{StaticResource ConsoleFade}"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                        <!-- Vertical only: the rows are measured at the column's width (long labels wrap instead of
                             widening the list past the screen edge). -->
                        <!-- The rows, and under them what the row in focus does (its AutomationProperties.HelpText) -->
                        <Grid Grid.Column="1" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer x:Name="SettingsRows" VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                <Grid Padding="0,4,0,24">
                                    <StackPanel x:Name="SystemSection0" Spacing="10" Visibility="{x:Bind ViewModel.CategoryVisibility(ViewModel.SystemCategory, 0), Mode=OneWay}">
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.OpenPickerCommand}" CommandParameter="audio" AutomationProperties.HelpText="{x:Bind ViewModel.AudioHintText, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.AudioOutputCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.SelectedAudio.Text, Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CycleSettingCommand}" CommandParameter="desktopicons" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.RestoreIconsDescription, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.RestoreIconsCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.OnOff(ViewModel.RestoreDesktopIcons), Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CycleSettingCommand}" CommandParameter="hidedesktopicons" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.HideIconsDescription, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.HideIconsCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.OnOff(ViewModel.HideDesktopIcons), Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CycleSettingCommand}" CommandParameter="parkpointer" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.ParkPointerDescription, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.ParkPointerCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.OnOff(ViewModel.ParkPointer), Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel x:Name="SystemSection1" Spacing="10" Visibility="{x:Bind ViewModel.CategoryVisibility(ViewModel.SystemCategory, 1), Mode=OneWay}">
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.OpenPickerCommand}" CommandParameter="controllerlayout" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.ControllerLayoutDescription, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.ControllerLayoutCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.SelectedControllerLayout.Text, Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <TextBlock Text="{x:Bind ViewModel.ControllerLayoutPreview, Mode=OneWay}" FontSize="22" Opacity="0.9" Margin="12,0,0,2"/>
                                        <TextBlock Text="{x:Bind ViewModel.Texts.ControllerLayoutDescription, Mode=OneWay}" FontSize="18" TextWrapping="Wrap" Opacity="0.72" Margin="12,0,0,8"/>
                                        <Button x:Name="HomeShortcutRow" Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.OpenShortcutEditorCommand}" CommandParameter="home">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.HomeButtonCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.HomeShortcutText, Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="MenuShortcutRow" Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.OpenShortcutEditorCommand}" CommandParameter="menu">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.SessionMenuCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.MenuShortcutText, Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="ExitShortcutRow" Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.OpenShortcutEditorCommand}" CommandParameter="exit">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.ExitShortcutCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.ExitShortcutText, Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CycleSettingCommand}" CommandParameter="autostart" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.AutoStartControllerDescription, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.AutoStartControllerCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.OnOff(ViewModel.AutoStartOnController), Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel x:Name="SystemSection2" Spacing="10" Visibility="{x:Bind ViewModel.CategoryVisibility(ViewModel.SystemCategory, 2), Mode=OneWay}">
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CycleSettingCommand}" CommandParameter="hdr" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.HdrDescription, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.HdrCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.HdrText, Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CycleSettingCommand}" CommandParameter="vrr" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.VrrDescription, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.VrrCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.VrrText, Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel x:Name="SystemSection3" Spacing="10" Visibility="{x:Bind ViewModel.CategoryVisibility(ViewModel.SystemCategory, 3), Mode=OneWay}">
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CycleSettingCommand}" CommandParameter="material" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.CardMaterialDescription, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.CardMaterialCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.GlassMaterialText, Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CycleSettingCommand}" CommandParameter="background" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.BackgroundDescription, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.BackgroundCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.BackgroundModeText, Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CycleSettingCommand}" CommandParameter="backgroundimage"
                                            Visibility="{x:Bind ViewModel.IsBackgroundImageMode, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.BackgroundImageCard, Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CycleSettingCommand}" CommandParameter="sounds" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.SoundsDescription, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.SoundsCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.OnOff(ViewModel.InterfaceSounds), Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.OpenPickerCommand}" CommandParameter="introstyle" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.IntroStyleDescription, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.IntroStyleCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.SelectedIntroStyle.Text, Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CycleSettingCommand}" CommandParameter="introsound" IsEnabled="{x:Bind ViewModel.IntroSoundRowEnabled, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.IntroSoundDescription, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.IntroSoundCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.OnOff(ViewModel.IntroSound), Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.PreviewIntroCommand}" IsEnabled="{x:Bind ViewModel.IntroSoundRowEnabled, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.IntroPreviewDescription, Mode=OneWay}">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.IntroPreviewCard, Mode=OneWay}"/>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.OpenPickerCommand}" CommandParameter="language" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.LanguageDescription, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.LanguageCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.SelectedLanguage.Text, Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CycleSettingCommand}" CommandParameter="startup" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.StartupDescription, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.StartupCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.OnOff(ViewModel.StartWithWindows), Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CycleSettingCommand}" CommandParameter="minimizetray" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.MinimizeToTrayDescription, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.MinimizeToTrayCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.OnOff(ViewModel.MinimizeToTray), Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CycleSettingCommand}" CommandParameter="updates" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.NotifyUpdatesDescription, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.NotifyUpdatesCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.OnOff(ViewModel.CheckUpdates), Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CycleSettingCommand}" CommandParameter="betas" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.BetaUpdatesDescription, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.BetaUpdatesCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.OnOff(ViewModel.BetaUpdates), Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CheckNowCommand}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.CheckNow, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Normal" FontSize="16"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.StartTourCommand}" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.TutorialDescription, Mode=OneWay}">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.TutorialCard, Mode=OneWay}"/>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.ShowSessionMenuTourCommand}" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.SessionTourDescription, Mode=OneWay}">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.SessionTourCard, Mode=OneWay}"/>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.OpenDataFolderCommand}" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.DataFolderDescription, Mode=OneWay}">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.DataFolderCard, Mode=OneWay}"/>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel x:Name="SystemSection4" Spacing="10" Visibility="{x:Bind ViewModel.CategoryVisibility(ViewModel.SystemCategory, 4), Mode=OneWay}">
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.OpenControllerTestCommand}" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.ControllerTestDescription, Mode=OneWay}">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.ControllerTestCard, Mode=OneWay}"/>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.TestConfirmCommand}" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.TvConfirmationDescription, Mode=OneWay}">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.TvConfirmationCard, Mode=OneWay}"/>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CreateShortcutCommand}" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.OneClickDescription, Mode=OneWay}">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.OneClickCard, Mode=OneWay}"/>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.OpenFeedbackCommand}">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.SendFeedback, Mode=OneWay}"/>
                                        </Button>
                                        <Button Style="{StaticResource ConsoleRow}" Command="{x:Bind ViewModel.CopyDiagnosticsReportCommand}" AutomationProperties.HelpText="{x:Bind ViewModel.Texts.DiagnosticsDescription, Mode=OneWay}">
                                            <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="{x:Bind ViewModel.Texts.DiagnosticsCard, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Text="{x:Bind ViewModel.Texts.CopyReport, Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <TextBlock FontSize="18" Opacity="0.72" Margin="12,8,0,0"><Run Text="Console Mode"/> <Run Text="{x:Bind ViewModel.AppVersion}"/></TextBlock>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                            <!-- The list fades into the background at an edge with more rows past it, instead of being cut
                                 (shown from code, ConsoleHomeView.UpdateRowsScroll) -->
                            <Rectangle x:Name="RowsFadeTop" Height="64" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0"
                                       OpacityTransition="{StaticResource ConsoleFade}">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F507090D" Offset="0"/>
                                        <GradientStop Color="#0007090D" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle x:Name="RowsFadeBottom" Height="150" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0"
                                       OpacityTransition="{StaticResource ConsoleFade}">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="#F507090D" Offset="0"/>
                                        <GradientStop Color="#0007090D" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <!-- Where the list is: a thin track with its thumb, right of the rows, only when it scrolls -->
                            <Grid x:Name="RowsScrollTrack" Width="5" HorizontalAlignment="Right" Margin="0,6,-22,6" IsHitTestVisible="False"
                                  Opacity="0" OpacityTransition="{StaticResource ConsoleFade}">
                                <Border CornerRadius="3" Background="#1FFFFFFF"/>
                                <Border x:Name="RowsScrollThumb" CornerRadius="3" Background="#A6FFFFFF" VerticalAlignment="Top" Height="40"/>
                            </Grid>
                            <TextBlock x:Name="RowHelp" Grid.Row="1" FontSize="18" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="12,0,12,4"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- The controller hints; LB / RB already sit by the tabs at the top -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="22" HorizontalAlignment="Right" Opacity="0.8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintConfirm, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.HintSelect, Mode=OneWay}" VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.Back, Mode=OneWay}" VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintMenu, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.StartNow, Mode=OneWay}" VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintAlt, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.Settings, Mode=OneWay}" VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>
            </StackPanel>
        </Grid>


        <!-- ───────────── Role panel (overlay) ───────────── -->
        <Grid x:Name="RolePanel" Visibility="{x:Bind ViewModel.IsRolePanelOpen, Mode=OneWay}" Background="#CC07090D">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" MaxWidth="900">
                <TextBlock Text="{x:Bind ViewModel.RolePanelTitle, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                    <Button x:Name="RolePlay" Style="{StaticResource ConsoleCard}" Width="240" Height="150"
                            Command="{x:Bind ViewModel.SetRoleCommand}" CommandParameter="0">
                        <StackPanel Spacing="12"><FontIcon Glyph="&#xE7FC;" FontSize="34"/><TextBlock Text="{x:Bind ViewModel.Texts.RolePlayHere, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ConsoleCard}" Width="240" Height="150"
                            Command="{x:Bind ViewModel.SetRoleCommand}" CommandParameter="1">
                        <StackPanel Spacing="12"><FontIcon Glyph="&#xE7E8;" FontSize="34"/><TextBlock Text="{x:Bind ViewModel.Texts.RoleTurnOff, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ConsoleCard}" Width="240" Height="150"
                            Command="{x:Bind ViewModel.SetRoleCommand}" CommandParameter="2">
                        <StackPanel Spacing="12"><FontIcon Glyph="&#xE7F4;" FontSize="34"/><TextBlock Text="{x:Bind ViewModel.Texts.RoleKeepOn, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource ConsoleSmallButton}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.CloseRolePanelCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.Back, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ───────────── Option picker (modal) ───────────── -->
        <Grid x:Name="PickerPanel" Visibility="{x:Bind ViewModel.IsPickerOpen, Mode=OneWay}" Background="#E607090D">
            <Grid MaxWidth="820" VerticalAlignment="Center" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.PickerTitle, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="PickerList" ItemsSource="{x:Bind ViewModel.PickerOptions, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PickerItem">
                                <Button Style="{StaticResource ConsoleRow}" Width="760"
                                        Command="{Binding ViewModel.PickOptionCommand, ElementName=Page}" CommandParameter="{x:Bind}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="24">
                                            <FontIcon Glyph="&#xE73E;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      Visibility="{x:Bind IsSelected}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontSize="20" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Row="2" Style="{StaticResource ConsoleSmallButton}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.ClosePickerCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.Back, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ───────────── First-run tour (overlay) ─────────────
             A veil over the whole window with a hole around the part of the screen the stop is about (drawn in
             ConsoleHomeView.PlaceTour), a ring around the hole and a card with the texts beside it. -->
        <Grid x:Name="ConsoleTourPanel" Visibility="{x:Bind ViewModel.IsConsoleTourOpen, Mode=OneWay}" Margin="-56,-48,-56,-32"
              TabFocusNavigation="Cycle" SizeChanged="OnTourPanelSizeChanged">
            <Path x:Name="TourVeil" Fill="#D907090D"/>
            <Border x:Name="TourRing" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="3" CornerRadius="20"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False"/>
            <Border x:Name="TourCard" HorizontalAlignment="Left" VerticalAlignment="Top" Width="600" CornerRadius="22" Padding="36,30"
                    Background="#F2121826" BorderBrush="#33FFFFFF" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="{x:Bind ViewModel.ConsoleTourProgress, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.ConsoleTourTitle, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind ViewModel.ConsoleTourBody, Mode=OneWay}" FontSize="20" TextWrapping="Wrap" LineHeight="30"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
                        <Button x:Name="ConsoleTourNextButton" Style="{StaticResource ConsolePlayButton}" Padding="30,12" MinWidth="180" Height="52"
                                Command="{x:Bind ViewModel.ConsoleTourNextCommand}">
                            <TextBlock Text="{x:Bind ViewModel.ConsoleTourNextText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/>
                        </Button>
                        <Button Style="{StaticResource ConsoleSmallButton}" Height="52" Padding="22,0" Command="{x:Bind ViewModel.ConsoleTourBackCommand}"
                                Visibility="{x:Bind ViewModel.CanGoBackInConsoleTour, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.Texts.Back, Mode=OneWay}" FontSize="18"/>
                        </Button>
                        <Button Style="{StaticResource ConsoleSmallButton}" Height="52" Padding="22,0" Command="{x:Bind ViewModel.EndTourCommand}"
                                Visibility="{x:Bind ViewModel.ShowSkipConsoleTour, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.Texts.SkipTour, Mode=OneWay}" FontSize="18"/>
                        </Button>
                    </StackPanel>
                    <!-- A next, B skips; the arrows move between the buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="18" Opacity="0.7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintConfirm, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="{x:Bind ViewModel.ConsoleTourNextText, Mode=OneWay}" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.ShowSkipConsoleTour, Mode=OneWay}">
                            <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="{x:Bind ViewModel.Texts.SkipTour, Mode=OneWay}" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- The stop's time running out: the tour moves on by itself when it fills (ConsoleTour.DwellTime) -->
                    <Grid Height="4" CornerRadius="2" Background="#26FFFFFF" Margin="0,4,0,0">
                        <Border x:Name="TourTimeBar" CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ShortcutEditorPanel" Visibility="{x:Bind ViewModel.IsShortcutEditorOpen, Mode=OneWay}" Background="#E607090D" TabFocusNavigation="Cycle">
            <Grid MaxWidth="1320" VerticalAlignment="Center" RowSpacing="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.ShortcutEditorTitle, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <ScrollViewer Grid.Row="1" IsTabStop="False" MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid ColumnSpacing="16" Margin="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#FF20292E" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel Spacing="12"><TextBlock Text="{x:Bind ViewModel.Texts.HomeButtonCard, Mode=OneWay}" FontSize="19" MinHeight="52" FontWeight="SemiBold" TextWrapping="Wrap"/><ContentControl x:Name="HomeShortcutPickerHost" IsTabStop="False" HorizontalContentAlignment="Stretch"/></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#FF20292E" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel Spacing="12"><TextBlock Text="{x:Bind ViewModel.Texts.SessionMenuCard, Mode=OneWay}" FontSize="19" MinHeight="52" FontWeight="SemiBold" TextWrapping="Wrap"/><ContentControl x:Name="MenuShortcutPickerHost" IsTabStop="False" HorizontalContentAlignment="Stretch"/></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#FF20292E" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel Spacing="12"><TextBlock Text="{x:Bind ViewModel.Texts.ExitShortcutCard, Mode=OneWay}" FontSize="19" MinHeight="52" FontWeight="SemiBold" TextWrapping="Wrap"/><ContentControl x:Name="ExitShortcutPickerHost" IsTabStop="False" HorizontalContentAlignment="Stretch"/></StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#FF20292E" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel Spacing="12"><TextBlock Text="{x:Bind ViewModel.Texts.TaskViewShortcutCard, Mode=OneWay}" FontSize="19" MinHeight="52" FontWeight="SemiBold" TextWrapping="Wrap"/><ContentControl x:Name="TaskViewShortcutPickerHost" IsTabStop="False" HorizontalContentAlignment="Stretch"/></StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
                <Button Grid.Row="2" Style="{StaticResource ConsoleSmallButton}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.CloseShortcutEditorCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10"><Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border><TextBlock Text="{x:Bind ViewModel.Texts.Back, Mode=OneWay}"/></StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ───────────── Controller test (overlay) ───────────── -->
        <Grid x:Name="ControllerTestPanel" Visibility="{x:Bind ViewModel.IsControllerTestOpen, Mode=OneWay}" Background="#07090D" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Texts.ControllerTestCard, Mode=OneWay}" FontSize="36" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.Texts.ControllerTestSteamHint, Mode=OneWay}" FontSize="17" TextWrapping="Wrap" MaxWidth="1100" HorizontalAlignment="Left"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Texts.ControllerDevicesHeading, Mode=OneWay}" Style="{StaticResource ConsoleHeading}" Margin="4,8,0,4"/>
                <TextBlock Text="{x:Bind ViewModel.ControllerDevicesText, Mode=OneWay}" FontFamily="Consolas" FontSize="16" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Texts.ControllerSampleHeading, Mode=OneWay}" Style="{StaticResource ConsoleHeading}" Margin="4,8,0,4"/>
                <TextBlock Text="{x:Bind ViewModel.ControllerSampleText, Mode=OneWay}" FontFamily="Consolas" FontSize="18" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16">
                <Button x:Name="CopyDiagnosticsButton" Style="{StaticResource ConsoleSmallButton}" Height="56" Padding="24,0" Command="{x:Bind ViewModel.CopyControllerDiagnosticsCommand}">
                    <TextBlock Text="{x:Bind ViewModel.Texts.CopyDiagnostics, Mode=OneWay}"/>
                </Button>
                <Button Style="{StaticResource ConsoleSmallButton}" Height="56" Padding="24,0" Command="{x:Bind ViewModel.CloseControllerTestCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource HintBadge}"><TextBlock Text="{x:Bind ViewModel.HintBack, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{x:Bind ViewModel.Texts.Back, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ───────────── Active session ───────────── -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" MaxWidth="720"
                    Visibility="{x:Bind ViewModel.IsConsoleActive, Mode=OneWay}">
            <Border Width="120" Height="120" CornerRadius="60" HorizontalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon Glyph="&#xE7FC;" FontSize="52" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.Texts.ActiveTitle, Mode=OneWay}" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.ActiveDescText, Mode=OneWay}" FontSize="20" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button x:Name="RestoreButton" Style="{StaticResource ConsolePlayButton}" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Command="{x:Bind ViewModel.RestoreNowCommand}">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <FontIcon Glyph="&#xE7A7;" FontSize="24"/>
                    <TextBlock Text="{x:Bind ViewModel.Texts.BackToPc, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <ProgressBar IsIndeterminate="True" Width="220" Visibility="{x:Bind ViewModel.IsRestoring, Mode=OneWay}"/>
            <TextBlock Text="{x:Bind ViewModel.ConsoleActiveHintText, Mode=OneWay}" FontSize="17" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </StackPanel>

        <!-- ───────────── Opening (over everything while the app loads) ─────────────
             "Aproximação": the logo comes from close to the camera, big and blurred, and settles sharp in the middle, then
             the name; shown and faded out from code (ConsoleHomeView.ShowIntro / HideIntro), skipped by any press, click or key. -->
        <Grid x:Name="IntroPanel" Visibility="Collapsed" Margin="-56,-48,-56,-32" Background="#07090D" Tapped="OnIntroTapped">
            <!-- Console Mode's own, "Liga o PC": the logo drawn as vectors (viewBox 256, like assets/icon.ico) so each part can
                 come on by itself: the power light, the base, the screen drawing itself, a green flash, the >_ typed, the name.
                 Opacities that start at 0 are set from code (ConsoleHomeView.ShowConsoleIntro). -->
            <Grid x:Name="IntroConsole">
                <Ellipse x:Name="IntroGlow" Width="900" Height="900" Opacity="0.55" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#552FD3A0" Offset="0"/>
                            <GradientStop Color="#1A2F6FD3" Offset="0.45"/>
                            <GradientStop Color="#0007090D" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
                    <Viewbox Width="132" Height="132" HorizontalAlignment="Center">
                        <Canvas Width="256" Height="256">
                            <Rectangle x:Name="LogoScreenFill" Canvas.Left="22" Canvas.Top="14" Width="212" Height="156" RadiusX="30" RadiusY="30" Fill="#33D69F"/>
                            <!-- Dash lengths are in stroke widths: one dash as long as the whole line, so the offset draws it -->
                            <Rectangle x:Name="LogoScreen" Canvas.Left="22" Canvas.Top="14" Width="212" Height="156" RadiusX="30" RadiusY="30"
                                       Stroke="#24292E" StrokeThickness="18" StrokeDashArray="40 40"/>
                            <Path x:Name="LogoChevron" Data="M64,62 L104,88 L64,114" Stroke="#33D69F" StrokeThickness="14" StrokeDashArray="7.2 7.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round" StrokeLineJoin="Round"/>
                            <!-- The box shows the cursor when it's typed; the cursor itself blinks -->
                            <Canvas x:Name="LogoCursorBox">
                                <Path x:Name="LogoCursor" Data="M118,124 L168,124" Stroke="#33D69F" StrokeThickness="14" StrokeDashArray="3.8 3.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round"/>
                            </Canvas>
                            <Rectangle x:Name="LogoBase" Canvas.Left="8" Canvas.Top="182" Width="240" Height="64" RadiusX="16" RadiusY="16" Fill="#24292E"/>
                            <Path x:Name="LogoDash" Data="M30,214 L50,214" Stroke="#33D69F" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse x:Name="LogoPowerGlow" Canvas.Left="176" Canvas.Top="161" Width="80" Height="80">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#B333D69F" Offset="0"/>
                                        <GradientStop Color="#0033D69F" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Canvas x:Name="LogoPower">
                                <Path Data="M206,200 A18,18 0 1 0 226,200" Stroke="#33D69F" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Data="M216,190 L216,212" Stroke="#33D69F" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="IntroName" Text="Console Mode" FontSize="46" FontWeight="SemiBold" CharacterSpacing="-10"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- In the mood of the Xbox 360's: green and silver ribbons orbiting into an orb on a light background, a flash,
                 the logo. Each ribbon is a dashed circle that turns inside a flattened frame (so its arcs orbit in
                 perspective), inside a frame that shrinks to the orb. -->
            <Grid x:Name="IntroX360" Visibility="Collapsed">
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#FFE6EBE7" Offset="0.55"/>
                            <GradientStop Color="#FFB9C2BD" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Grid x:Name="X360Ribbons"/>
                <Ellipse x:Name="X360Orb" Width="240" Height="240">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#E6A0E65A" Offset="0.35"/>
                            <GradientStop Color="#005CBE28" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Opacities that start at 0 are set from code: the Composition fades don't move a XAML Opacity -->
                <Rectangle x:Name="X360Flash" Fill="White"/>
                <StackPanel x:Name="X360Mark" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
                    <Image Source="ms-appx:///Assets/Intro/logo.png" Width="132" Height="132"/>
                    <TextBlock Text="Console Mode" FontSize="46" FontWeight="SemiBold" CharacterSpacing="-10" Foreground="#FF1F2A24" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- In the mood of the PS4's: a deep blue with waves of light drifting across and particles rising, the logo
                 coming up in the light. -->
            <Grid x:Name="IntroPs4" Visibility="Collapsed">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF0A3A9E" Offset="0"/>
                            <GradientStop Color="#FF06205E" Offset="0.55"/>
                            <GradientStop Color="#FF020B26" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas x:Name="Ps4Waves" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Canvas x:Name="Ps4Particles"/>
                <Ellipse x:Name="Ps4Light" Width="1100" Height="1100">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#59A0C8FF" Offset="0"/>
                            <GradientStop Color="#00A0C8FF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel x:Name="Ps4Mark" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
                    <Image Source="ms-appx:///Assets/Intro/logo.png" Width="132" Height="132"/>
                    <TextBlock Text="Console Mode" FontSize="46" FontWeight="SemiBold" CharacterSpacing="-10" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
